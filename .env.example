# Copy to .env.local and fill in. Never commit real values.

# Supabase (local values come from `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Background jobs (Inngest)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production without RESEND_API_KEY refuses to send. Set to "console" to write emails to .local-outbox/ instead (demos, e2e).
EMAIL_DRIVER=
